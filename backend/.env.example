# InvoiceIQ Backend Configuration

PROJECT_NAME=InvoiceIQ
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://root:root@localhost:5432/invoiceiq_db

# Grok / OpenAI-compatible API Configuration
# Supports Groq or xAI endpoints
XAI_API_KEY=your_api_key_here
XAI_BASE_URL=https://api.groq.com/openai/v1
XAI_MODEL=openai/gpt-oss-120b

# For official xAI endpoint:
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-2-latest

# Storage Configuration
UPLOAD_DIR=uploads/invoices
MAX_UPLOAD_SIZE_MB=15

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Optional OCR binary override (leave empty if in system PATH)
TESSERACT_CMD=
